---
import { ArrowRight } from "@lucide/astro";
import { siX } from "simple-icons";
import ThemeToggle from "@/components/grace-hymns/theme-toggle.tsx";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/lib/site";

const iconClass =
  "h-5 w-5 text-gh-secondary transition-colors group-hover:text-gh-on-background";
const linkClass = "group rounded-md p-2 outline-offset-2 focus-visible:outline-2 focus-visible:outline-gh-secondary";
const external = { target: "_blank", rel: "noopener noreferrer" };
---

<BaseLayout title={siteConfig.name} canonical="/">
  <main class="grace-hymns-theme relative flex min-h-screen flex-col items-center justify-center gap-5 bg-gh-background px-6 text-center text-gh-on-background">
    <div class="absolute right-5 top-5">
      <ThemeToggle client:only="react">
        <button
          slot="fallback"
          type="button"
          aria-label="Toggle theme"
          class="flex size-9 items-center justify-center rounded-full border border-gh-outline-variant/60 dark:border-neutral-800"
        ></button>
      </ThemeToggle>
    </div>

    <h1 class="text-2xl tracking-tight sm:text-3xl">
      <span class="font-light">somo</span><span class="font-bold">singogo</span>
    </h1>

    <nav aria-label="Links" class="flex items-center gap-2">
      <a href="https://github.com/CSingogo" aria-label="GitHub" class={linkClass} {...external}>
        <svg class={iconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
      </a>
      <a href="https://www.linkedin.com/in/chisomo-singogo-b52986a5/" aria-label="LinkedIn" class={linkClass} {...external}>
        <svg class={iconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
          <rect width="4" height="12" x="2" y="9"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
      </a>
      <a href="https://x.com/thisischisomo" aria-label="X" class={linkClass} {...external}>
        <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d={siX.path}></path>
        </svg>
      </a>
    </nav>

    <a
      href="/grace-hymns/home"
      class="group flex items-center gap-1.5 text-sm text-gh-secondary transition-colors hover:text-gh-on-background"
    >
      Grace Hymns
      <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
    </a>
  </main>
</BaseLayout>
