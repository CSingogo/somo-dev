---
import { ArrowLeft } from "@lucide/astro";
import PrivacyFooter from "@/components/grace-hymns/privacy-footer.astro";
import PrivacyHeader from "@/components/grace-hymns/privacy-header.astro";
import SectionHeading from "@/components/grace-hymns/section-heading.astro";
import ScrollProgressBar from "@/components/grace-hymns/scroll-progress-bar.astro";
import GraceHymnsLayout from "@/layouts/GraceHymnsLayout.astro";
import { graceHymnsConfig } from "@/lib/site";

const description = `Privacy Policy for the ${graceHymnsConfig.name} mobile application.`;
---

<GraceHymnsLayout
  title="Privacy Policy"
  description={description}
  canonical="/grace-hymns/privacy-policy"
  ogTitle={`Privacy Policy — ${graceHymnsConfig.name}`}
  withOgImage={false}
>
  <PrivacyHeader />
  <ScrollProgressBar />
  <main class="relative pb-24 pt-12">
    <div class="mx-auto mb-12 max-w-[800px] px-4 md:px-0">
      <a
        href="/grace-hymns/home"
        class="group inline-flex items-center gap-2 text-gh-primary transition-all hover:underline"
      >
        <ArrowLeft class="h-[18px] w-[18px]" stroke-width={1.5} />
        <span class="text-xs font-semibold uppercase tracking-[0.05em]">
          Back to Grace Hymns
        </span>
      </a>
    </div>
    <article class="mx-auto max-w-[800px] px-4 md:px-0">
      <header class="mb-16 border-b border-gh-outline-variant/20 pb-8">
        <h1 class="mb-4 font-serif text-[40px] font-bold leading-[48px] tracking-[-0.02em] text-gh-on-background">
          Privacy{" "}
          <span class="text-gh-primary-container">Policy</span>
        </h1>
        <div class="flex flex-wrap items-center gap-3">
          <span class="rounded border border-gh-outline-variant/30 bg-gh-surface-container-low px-3 py-1 font-[family-name:var(--font-jetbrains-mono)] text-[13px] text-gh-on-surface-variant">
            VERSION 1.0.0
          </span>
          <p class="text-base italic text-gh-secondary">
            Last updated: July 8, 2026
          </p>
        </div>
      </header>

      <section class="space-y-12">
        <div>
          <SectionHeading>1. Introduction</SectionHeading>
          <div class="space-y-6 leading-relaxed text-gh-on-background">
            <p>
              Grace Hymns (&quot;Grace Hymns,&quot; &quot;we,&quot;
              &quot;us,&quot; or &quot;our&quot;) respects the privacy of its
              users (&quot;User,&quot; &quot;your,&quot; or &quot;you&quot;).
              This Privacy Policy explains how we collect, use, disclose, and
              safeguard your information when you use the Grace Hymns mobile
              application (the &quot;App&quot;). Grace Hymns is a mobile
              hymnbook that lets users browse, search, and save hymns.
            </p>
            <p class="font-semibold uppercase tracking-tight">
              PLEASE READ THIS PRIVACY POLICY CAREFULLY TO UNDERSTAND OUR
              POLICIES AND PRACTICES REGARDING YOUR INFORMATION AND HOW WE
              WILL TREAT IT.
            </p>
            <p>
              BY ACCESSING OR USING OUR APP, YOU AGREE TO ACCEPT ALL THE
              TERMS CONTAINED IN THIS PRIVACY POLICY. IF YOU DO NOT AGREE,
              PLEASE DO NOT USE THE APP.
            </p>
            <p>
              IF YOU HAVE ANY QUESTIONS, PLEASE EMAIL US AT{" "}
              <a
                href="mailto:singogosingogo@gmail.com"
                class="border-b border-gh-primary-container/30 font-semibold text-gh-primary-container transition-all hover:border-gh-primary-container"
              >
                singogosingogo@gmail.com
              </a>
            </p>
            <div class="border-l-2 border-gh-primary-container bg-gh-surface-container-low p-4 italic text-gh-secondary">
              WE DO NOT SELL YOUR PERSONAL INFORMATION, NOR DO WE INTEND TO
              DO SO.
            </div>
          </div>
        </div>

        <div>
          <SectionHeading>2. What Information Do We Collect?</SectionHeading>
          <div class="space-y-6">
            {[
              {
                letter: "a",
                title: "Account Information",
                text: "Grace Hymns does not require account registration. The App works without creating an account.",
              },
              {
                letter: "b",
                title: "Device and Usage Information",
                text: "We may collect non-personally identifying information such as device type, operating system version, and general usage patterns to improve the App.",
              },
              {
                letter: "c",
                title: "Hymn Catalog Data",
                text: "Hymn content (titles, lyrics, numbers, categories) is delivered from our cloud-hosted catalog. This is public hymn data, not personal information.",
              },
              {
                letter: "d",
                title: "Locally Stored Preferences",
                text: "Favorites and dark mode preferences are stored locally on your device. This data never leaves your device unless you choose to share hymn text via the native share sheet.",
              },
            ].map((item) => (
              <div class="flex items-start gap-4">
                <span class="mt-1 text-xs font-bold text-gh-primary-container">
                  {item.letter}.
                </span>
                <p>
                  <strong class="text-gh-on-background">
                    {item.title}
                  </strong>{" "}
                  — {item.text}
                </p>
              </div>
            ))}
          </div>
        </div>

        <div>
          <SectionHeading>3. Data Security & Third Parties</SectionHeading>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            <div class="rounded border border-gh-outline-variant/30 p-6">
              <h3 class="mb-3 font-serif text-2xl font-semibold text-gh-on-background">
                Cloud Infrastructure
              </h3>
              <p class="text-base text-gh-secondary">
                Hymn catalog content is served through our cloud
                infrastructure. We do not collect personal data for this
                purpose; hosting providers may process limited technical
                diagnostics required to keep the service available.
              </p>
            </div>
            <div class="rounded border border-gh-outline-variant/30 p-6">
              <h3 class="mb-3 font-serif text-2xl font-semibold text-gh-on-background">
                Local Encryption
              </h3>
              <p class="text-base text-gh-secondary">
                User preferences and saved hymns are stored in an encrypted
                sandboxed environment on your mobile device, inaccessible to
                other applications.
              </p>
            </div>
          </div>
        </div>
      </section>
    </article>
  </main>
  <PrivacyFooter />
</GraceHymnsLayout>
