---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" canonical="/404" noindex>
  <main class="flex min-h-screen flex-col items-center justify-center gap-4 bg-black px-6 text-center text-neutral-100">
    <p class="font-mono text-sm uppercase tracking-[0.3em] text-neutral-500">404</p>
    <h1 class="text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="max-w-sm text-neutral-400">That page doesn't exist or has moved.</p>
    <a href="/" class="mt-2 text-sm text-neutral-300 underline underline-offset-4 hover:text-white">
      Back to somosingogo.dev
    </a>
  </main>
</BaseLayout>
