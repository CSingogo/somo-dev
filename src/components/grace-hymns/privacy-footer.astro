---
const year = new Date().getFullYear();
---

<footer class="border-t border-gh-outline-variant/20 bg-gh-surface-container-low">
  <div class="mx-auto grid max-w-[1280px] grid-cols-1 gap-8 px-4 py-12 md:grid-cols-2 md:px-10">
    <div>
      <div class="mb-4">
        <span class="font-[family-name:var(--font-work-sans)] text-sm font-bold lowercase tracking-tight text-gh-on-background">
          grace hymns
          <span
            aria-hidden
            class="ml-0.5 inline-block h-2 w-2 translate-y-[-1px] rounded-full bg-gh-primary-container"
          />
        </span>
      </div>
      <p class="max-w-sm text-sm text-gh-on-surface-variant">
        © {year} Grace Hymns. Built for devotion and
        technical precision. Dedicated to preserving the legacy of sacred
        music through modern technology.
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-x-8 gap-y-4 md:justify-end">
      <a
        href="/grace-hymns/privacy-policy"
        class="text-xs text-gh-on-surface-variant opacity-80 transition-all hover:text-gh-primary hover:opacity-100 hover:underline"
      >
        Privacy Policy
      </a>
      <a
        href="mailto:singogosingogo@gmail.com"
        class="text-xs text-gh-on-surface-variant opacity-80 transition-all hover:text-gh-primary hover:opacity-100 hover:underline"
      >
        Support
      </a>
    </div>
  </div>
</footer>