---
const features = [
  {
    number: "01",
    title: "Swift Discovery",
    description:
      "Engineered search algorithms that find hymns by title, category, or lyrics in milliseconds.",
  },
  {
    number: "02",
    title: "Cloud Infrastructure",
    description:
      "Cloud-delivered catalog updates keep hymns current without exposing personal data on our servers.",
  },
  {
    number: "03",
    title: "Adaptive UI",
    description:
      "Native Dark Mode and typography controls tailored for legibility in any devotional environment.",
  },
  {
    number: "04",
    title: "Total Autonomy",
    description:
      "Sophisticated caching mechanisms ensure the spirit of worship remains uninterrupted, even offline.",
  },
];
---

<section id="features" class="py-32">
  <div class="mx-auto max-w-[1200px] px-6 md:px-20">
    <div class="mx-auto mb-24 max-w-2xl text-center">
      <span class="mb-4 block text-[11px] font-bold uppercase tracking-[0.4em] text-gh-primary-container">
        Core Attributes
      </span>
      <h2 class="mb-6 font-serif text-4xl font-bold tracking-tight text-gh-on-background md:text-5xl">
        Precision in Every Note.
      </h2>
      <div class="mx-auto h-1 w-12 bg-gh-primary-container" />
    </div>
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">
      {features.map((feature) => (
        <div class="group">
          <span class="mb-6 block font-serif text-4xl italic text-gh-outline-variant transition-colors duration-500 group-hover:text-gh-primary-container">
            {feature.number}
          </span>
          <h3 class="mb-4 font-serif text-xl font-bold text-gh-on-background">
            {feature.title}
          </h3>
          <p class="text-sm font-light leading-relaxed text-gh-secondary">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
