---
import { Sparkles } from "@lucide/astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-gh-outline-variant py-20">
  <div class="mx-auto max-w-[1200px] px-6 md:px-20">
    <div class="grid grid-cols-1 gap-16 md:grid-cols-4 md:gap-8">
      <div class="md:col-span-2">
        <div class="mb-6 flex items-center gap-2">
          <Sparkles class="h-5 w-5 fill-gh-primary text-gh-primary" stroke-width={1.5} />
          <span class="font-serif text-lg font-bold tracking-tight">
            Grace Hymns
          </span>
        </div>
        <p class="max-w-xs text-xs font-light leading-relaxed text-gh-secondary">
          A refined digital companion for worship, built with precision and
          reverence. © {year}. All rights reserved.
        </p>
      </div>
      <div>
        <h4 class="mb-8 text-[10px] font-bold uppercase tracking-[0.3em] text-gh-on-background">
          Product
        </h4>
        <ul class="space-y-4">
          <li>
            <a
              href="/grace-hymns/privacy-policy"
              class="text-xs text-gh-secondary transition-colors hover:text-gh-primary"
            >
              Privacy Policy
            </a>
          </li>
        </ul>
      </div>
      <div>
        <h4 class="mb-8 text-[10px] font-bold uppercase tracking-[0.3em] text-gh-on-background">
          Connect
        </h4>
        <ul class="space-y-4">
          <li>
            <a
              href="mailto:singogosingogo@gmail.com"
              class="text-xs text-gh-secondary transition-colors hover:text-gh-primary"
            >
              Contact Support
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>
