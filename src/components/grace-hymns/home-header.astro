---
import GraceHymnsThemeToggle from "./theme-toggle.tsx";
---

<header class="shrink-0 border-b border-gh-outline-variant bg-gh-background/90 backdrop-blur-sm">
  <nav class="mx-auto flex max-w-[1200px] items-center justify-between px-5 py-4 sm:px-6 md:px-12 md:py-5 lg:px-20">
    <a
      href="/grace-hymns/home"
      class="font-[family-name:var(--font-work-sans)] text-lg font-bold lowercase tracking-tight text-gh-on-background"
    >
      grace hymns
      <span
        aria-hidden
        class="ml-0.5 inline-block h-2 w-2 translate-y-[-1px] rounded-full bg-gh-primary-container"
      />
    </a>
    <GraceHymnsThemeToggle client:only="react">
    <button
      slot="fallback"
      type="button"
      aria-label="Toggle theme"
      class="flex size-9 items-center justify-center rounded-full border border-gh-outline-variant/60 dark:border-neutral-800"
    ></button>
  </GraceHymnsThemeToggle>
  </nav>
</header>