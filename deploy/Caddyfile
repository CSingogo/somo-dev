# Source of truth for /etc/caddy/Caddyfile on the VPS. CI only rsyncs dist/;
# changes here must be installed by hand:
#   scp deploy/Caddyfile somo@31.97.114.157:/tmp/Caddyfile
#   ssh somo@31.97.114.157 'sudo install -m 644 /tmp/Caddyfile /etc/caddy/Caddyfile && sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy'

www.somosingogo.dev {
	redir https://somosingogo.dev{uri} permanent
}

somosingogo.dev {
	root * /var/www/somo-dev/dist
	encode zstd gzip

	# Next.js-era URLs that must keep working
	redir /grace-hymns /grace-hymns/home permanent
	redir /sitemap.xml /sitemap-index.xml permanent

	# Astro emits build.format "file" (home.html), so serve /grace-hymns/home
	# without a trailing slash or extension.
	try_files {path} {path}.html {path}/index.html

	handle_errors {
		rewrite * /404.html
		file_server
	}

	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	file_server
}
